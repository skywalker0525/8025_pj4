<?xml version="1.0"?>
<sdf version="1.6">
  <model name="overhead_camera">
    <static>true</static>
    <link name="overhead_camera_link">
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <sensor name="overhead_rgb_sensor" type="camera">
        <always_on>true</always_on>
        <update_rate>10.0</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.55</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>80.0</far>
          </clip>
        </camera>
        <plugin name="overhead_camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <remapping>image_raw:=overhead_camera/image_raw</remapping>
            <remapping>camera_info:=overhead_camera/camera_info</remapping>
          </ros>
          <frame_name>overhead_camera_link</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
